              <div className="bg-gray-900/50 rounded-lg border border-gray-700 overflow-hidden">
                <div className="p-4 overflow-x-auto">
                  <SyntaxHighlighter
                    language="python"
                    style={monokai}
                    customStyle={{
                      background: 'transparent',
