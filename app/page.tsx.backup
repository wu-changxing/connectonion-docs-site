                  </SyntaxHighlighter>
                </div>
              </div>
            ) : (
              <div className="bg-gray-900/50 rounded-lg border border-gray-700 overflow-hidden">
                <div className="p-3">
                  <SyntaxHighlighter
                    language="python"
                    style={monokai}
                    customStyle={{
